# 复制本文件为 .env 并填入真实值。开发期可留空（PROVIDER_MODE=mock 完全离线）。
# 真实冒烟/验收前由产品经理填入阿里云百炼 Key。
PROVIDER_MODE=mock
DASHSCOPE_API_KEY=

# 讯飞发音评测（需 APPID + APIKey + APISecret 三项，后续接入时补）
XF_API_KEY=
XF_APPID=
XF_API_SECRET=

# 模型（候选，验收前可按需调整型号）
MODEL_ASR=paraformer-realtime-v2
MODEL_LLM=qwen-plus
MODEL_TTS=cosyvoice-v2
TTS_VOICE=loongabby_v2

# 音频转码
FFMPEG_BIN=ffmpeg

# 上传上限（文字长度上限固定为 2000 字符，见 schemas/turn.py）
MAX_AUDIO_MB=10

# 预算与运行上限（金额是设计预算，未实测报价）
BUDGET_SESSION=3.00
BUDGET_USER_DAY=10.00
BUDGET_PROJECT_DAY=100.00
BUDGET_END_RESERVE=0.30
MAX_TOOLS_PER_TURN=3
MAX_TOOL_RETRY=1
MAX_TEACH_ADJUST=2
NOMINAL_COST_PER_TURN=0.10
